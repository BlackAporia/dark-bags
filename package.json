{
  "name": "dark-bags",
  "version": "0.1.0",
  "private": true,
  "description": "DARK BAGS: a top-down extraction shooter in the browser, with private stakes on Starknet",
  "homepage": "https://dark-bags.com",
  "repository": { "type": "git", "url": "https://github.com/BlackAporia/dark-bags.git" },
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "og": "node scripts/make-og.mjs",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "build:wallets": "node scripts/build-wallets.js",
    "sim": "node scripts/sim.js",
    "house": "node scripts/house.js",
    "vault:deploy": "node scripts/deploy-vault.mjs",
    "test:contracts": "cd contracts && snforge test"
  },
  "dependencies": {
    "@avnu/avnu-sdk": "^4.2.0",
    "@fatsolutions/tongo-sdk": "^1.5.0",
    "@privy-io/node": "^0.35.0",
    "starknet": "^10.8.0",
    "starkzap": "^4.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cartridge/controller": "^0.13.16",
    "@privy-io/js-sdk-core": "^0.77.0",
    "@starknet-io/get-starknet-core": "^6.0.1",
    "esbuild": "^0.28.2"
  }
}
